{
    "compilerOptions": {
        "lib": ["es2022", "DOM"],
        "types": ["node", "@playwright/test", "ts-node"],
        "target": "es2022",
        "module": "commonjs",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "strict": true,
        "moduleResolution": "Node",
        "baseUrl": "./",
        "paths": {
            "@configs/*": ["configs/*"],
            "@constants/*": ["constants/*"],
            "@fixtures/*": ["fixtures/*"],
            "@helper/*": ["helper/*"],
            "@hooks/*": ["hooks/*"],
            "@pages/*": ["pages/*"],
            "@test-data/*": ["test-data/*"],
            "@tests/*": ["tests/*"],
            "@utils/*": ["utils/*"]
        }
    },
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "reports", "test-results", "playwright-report"]
}
